# ─────────────────────────────────────────────────────────────
# DoNext — server environment (copy to server/.env)
# Never commit real secrets. Generate JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/donext

# At least 32 random characters. REQUIRED.
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API.
# Include the Capacitor native origins if you build mobile apps.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost

# Serve the built React app (client/dist) from Express. Use "true" for single-server deploys.
SERVE_CLIENT=false

# Set to 1 (or the number of proxies) when running behind Nginx/Cloudflare/a PaaS load balancer
TRUST_PROXY=0

# Public URL of the web app (including any sub-path), used in password reset emails.
APP_URL=http://localhost:5173

# Outgoing email for password resets and shared-list invitations. Leave SMTP_HOST empty in
# development: emails are then printed in the server log instead of being sent.
# Free option: Gmail with an App password (smtp.gmail.com, port 465, SMTP_SECURE=true);
# see docs/DEPLOYMENT.md. Any SMTP provider works (Brevo, Resend, Amazon SES, Postmark, …).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DoNext <you@gmail.com>
